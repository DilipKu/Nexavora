---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import jsonData from "@data/sections/insights.json";

interface Article {
  category: string;
  title: string;
  excerpt: string;
  readTime: string;
  date: string;
  href: string;
}

interface Props {
  title?: string;
  tagline?: string;
  description?: string;
  items?: Article[];
  class?: string;
}

const props = Astro.props as Props;
const title = props.title ?? jsonData.title;
const tagline = props.tagline ?? jsonData.tagline;
const description = props.description ?? jsonData.description;
const items = props.items ?? jsonData.items;
---

<Section id="insights" tone="page" class:list={["py-16 lg:py-24 bg-surface text-brand-dark relative", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.25rem,4vw,4rem)]">
    <div class="mb-12 flex flex-col justify-between gap-4 md:flex-row md:items-end lg:mb-16">
      <div class="max-w-2xl">
        {tagline && <Text tag="p" variant="accent-label" class="mb-3 font-semibold tracking-[0.18em]">{tagline}</Text>}
        <Heading tag="h2" variant="section-title" class="text-[clamp(2rem,3.5vw,3.25rem)] font-bold tracking-tight">{title}</Heading>
      </div>
      {description && <Text variant="lead" class="max-w-md text-sm opacity-80">{description}</Text>}
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {items.map((article) => (
        <a href={article.href} class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-black/10 bg-surface p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-accent/40 hover:shadow-lg dark:border-white/10 sm:p-8">
          <div>
            <div class="mb-4 flex items-center justify-between text-xs text-brand-dark/60 dark:text-white/60">
              <span class="rounded-full bg-brand-accent/15 px-3 py-1 font-semibold text-brand-dark dark:bg-brand-accent/20 dark:text-brand-accent">{article.category}</span>
              <span>{article.readTime}</span>
            </div>
            <Heading tag="h3" variant="feature-title" class="mb-3 text-xl font-bold tracking-tight text-brand-dark group-hover:text-brand-accent transition-colors dark:text-white">
              {article.title}
            </Heading>
            <Text variant="body" class="mb-6 text-sm leading-relaxed opacity-80">
              {article.excerpt}
            </Text>
          </div>
          <div class="flex items-center justify-between border-t border-black/5 pt-4 text-xs font-semibold text-brand-accent dark:border-white/5">
            <span>Read Article</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</Section>
